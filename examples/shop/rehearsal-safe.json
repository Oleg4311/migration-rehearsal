{
  "setup": "schema.sql",
  "seed": "seed.sql",
  "clients": 4,
  "workload": [
    {
      "name": "чтение заказа",
      "kind": "read",
      "sql": "SELECT * FROM orders WHERE id = {{id}}",
      "weight": 6
    },
    {
      "name": "заказы клиента",
      "kind": "read",
      "sql": "SELECT count(*) FROM orders WHERE id BETWEEN {{id}} AND {{id}} + 50",
      "weight": 1
    },
    {
      "name": "новый заказ",
      "kind": "write",
      "sql": "INSERT INTO orders (customer_id, total, note) VALUES (1 + ({{seq}} % 1000), 10, 'x')",
      "weight": 2
    },
    {
      "name": "смена статуса",
      "kind": "write",
      "sql": "UPDATE orders SET status = 'paid' WHERE id = {{id}}",
      "weight": 2
    }
  ],
  "longReader": {
    "sql": "SELECT count(*) FROM orders",
    "holdMs": 1500
  },
  "migrations": [
    "migrations/safe/001_add_column.sql",
    "migrations/safe/002_default_later.sql",
    "migrations/safe/003_index_concurrently.sql",
    "migrations/safe/004_expand_type.sql",
    "migrations/safe/005_fk_not_valid.sql",
    "migrations/safe/006_fk_validate.sql",
    "migrations/safe/007_check_not_valid.sql",
    "migrations/safe/008_check_validate.sql",
    "migrations/safe/009_set_not_null.sql"
  ]
}
